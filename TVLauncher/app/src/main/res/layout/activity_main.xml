<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false"
    android:paddingTop="32dp" android:paddingBottom="48dp">

    <TextClock
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginEnd="56dp"
        android:format12Hour="h:mm a" android:format24Hour="HH:mm"
        android:textColor="#CCFFFFFF" android:textSize="22sp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="64dp" android:layout_marginBottom="20dp"
        android:textColor="#FFFFFF" android:textSize="40sp" android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false"
        android:paddingStart="52dp" android:paddingEnd="52dp"
        android:paddingTop="28dp" android:paddingBottom="28dp" />
</LinearLayout>
